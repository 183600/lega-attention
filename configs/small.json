{
  "_说明": "small 正式实验配置 (~30M 参数)。建议 GPU + bf16；use_sdpa_standard=false 使全部变体共用显式注意力路径，避免实现差异混入方法对比",
  "d_model": 384,
  "n_layers": 6,
  "n_heads": 6,
  "ffn_mult": 4,
  "block_size": 1024,
  "dropout": 0.0,
  "attn_dropout": 0.0,
  "gate_bias_init": 2.0,
  "use_sdpa_standard": false,

  "batch_size": 16,
  "grad_accum": 1,
  "steps": 8000,
  "lr": 0.0006,
  "warmup": 300,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "train_ctx": 1024,
  "amp": true,
  "seed": 1337,
  "seeds": [1337, 2024, 42, 7, 2025],

  "log_every": 20,
  "eval_every": 500,
  "eval_iters": 50,

  "design": {
    "alpha": 0.05,
    "power": 0.8,
    "multiplicity": "holm_worst_case",
    "run_order": "randomized_blocked"
  },

  "ruler": {
    "ctx_lens": [256, 512, 1024],
    "n_samples": 30,
    "max_new": 12,
    "fwe_max_new": 44,
    "vt_chains": 4,
    "vt_depth": 4,
    "seed": 1234
  },

  "analysis": {
    "n_examples": 40,
    "tau": 0.5
  },

  "latency": {
    "ctx_lens": [256, 512, 1024],
    "batch_sizes": [1, 8],
    "decode_tokens": 64,
    "iters": 20,
    "warmup": 5
  }
}
